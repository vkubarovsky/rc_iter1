\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces CLAS6 $\eta $, $\sigma _{U}$. This channel probes $2X_u - X_d$.}}{10}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces CLAS6 $\eta $, $\sigma _{LT}$.}}{10}{figure.6}\protected@file@percent }
