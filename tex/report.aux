\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Hall A 2017, $\pi ^0$ off the \emph  {neutron}: $\sigma _{T}$ and $\sigma _{LT}$. Four points, uncertainties of 42 to 90\,\%, and the sole constraint on $n/p$.}}{11}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Neutron $\sigma _{TT}$ (top) and Hall A 2016 proton $\sigma _{T}$ (bottom). The latter is the worst-described set in the fit at 4.5 per point, with its normalisation already pulled $1.8\sigma $.}}{12}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Hall A 2016, $\sigma _{LT}$ and $\sigma _{TT}$.}}{13}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Hall A 2011, $\sigma _{U}$. This set is published in the Drechsel--Tiator normalisation; $\sigma _{LT}$ and $\sigma _{LT'}$ are converted by $\gamma = 2M x_B/\sqrt  {Q^2}$ before comparison.}}{14}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Hall A 2011, $\sigma _{LT}$ and $\sigma _{TT}$.}}{15}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Hall A 2011, $\sigma _{LT'}$.}}{16}{figure.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Hall A 2021, $\sigma _{U}$. The only data above $Q^2 = 4.3$, reaching $8.31\ \mathrm  {GeV}^2$; left out of the fit the model overshoots these points by a factor 1.8.}}{17}{figure.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Hall A 2021, $\sigma _{LT}$ and $\sigma _{TT}$.}}{18}{figure.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Hall A 2021, $\sigma _{LT'}$.}}{19}{figure.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces CLAS12 cross sections, $\sigma _{U}$ --- \emph  {not} in the fit, and preliminary. Predicted at 2.39 per point.}}{20}{figure.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces CLAS12, $\sigma _{LT}$, blind: 20.4 per point. This is the clearest single picture of the model's failure in $\sigma _{LT}$.}}{21}{figure.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces CLAS12, $\sigma _{TT}$, blind: 3.51 per point.}}{22}{figure.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces COMPASS 2025. The model is averaged over the four-dimensional grid of the measurement, eq.~(16) of the paper, weighted by cell volume: a cell rectangular in $(Q^2,\nu )$ is not rectangular in $x_B$, and evaluating at the quoted mean kinematics overshoots by a factor five to eight.}}{23}{figure.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces De Masi $A_{LU}(\phi )$: all 60 bins, 12 points in $\phi $ each. The model supplies the denominator of eq.~(\ref {eq:phidecomp}) from its own $\sigma _{LT}$ and $\sigma _{TT}$, so no free $\beta ,\gamma $ are fitted per bin --- a three-parameter fit per bin is unstable, the denominator passing near zero in 13 of the 60.}}{24}{figure.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Top: the published De Masi $\alpha $, kept out of the fit as the same measurement as the figure above. Bottom: the Zhao $\eta $ beam-spin asymmetry, where the published GK curve is near zero.}}{25}{figure.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces CLAS12 $\sigma _{LT'}/\sigma _0$.}}{26}{figure.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces eg1-dvcs, polarised target: the $A_{LL}$ moments, at the experiment's two settings. These are the only observables in the database sensitive to the relative phase of $T_{01}$ and $U_{01}$; without them it is unconstrained.}}{26}{figure.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces eg1-dvcs, the $A_{UL}$ moments.}}{27}{figure.25}\protected@file@percent }
